<Window x:Class="poligon_pezeglądarka_grafiki.View.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:local="clr-namespace:poligon_pezeglądarka_grafiki.View"
        xmlns:vm="clr-namespace:poligon_pezeglądarka_grafiki.ViewModel"
        xmlns:control="clr-namespace:poligon_pezeglądarka_grafiki.View.Control"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        d:DataContext="{d:DesignInstance vm:EditWindowViewModel}"
        mc:Ignorable="d"
        x:Name="EditWindowS" Title="EditWindow" Height="450" Width="800"
        Style="{StaticResource MaterialDesignWindow }"  WindowStyle="None"    
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}" 
        Icon="/img/73042biohazard_109537(1).ico"          
        ResizeMode="NoResize" WindowState="Maximized"
        
        >
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Border CornerRadius="5" BorderBrush="Indigo" BorderThickness="2" Padding="6" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" MaxHeight="40"/> <!-- pasek tytułowy -->                
                <RowDefinition Height="auto" /><!-- to jest pasek narzędzi -->
                <RowDefinition Height="*" /><!-- to jest obszar roboczy -->
                <RowDefinition Height="auto" /><!-- to jest pasek stanu -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"><!-- pasek tytułowy-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- ikona i tytół -->
                <Image Grid.Column="0" Width="22" Height="22" Margin="4" Source="/img/73042biohazard_109537(1).ico"/>
                <TextBlock Grid.Column="1" Margin="4 0 0 0" VerticalAlignment="Center" FontSize="14" Text="{Binding WindowTitle}"/>
                <Button Grid.Column="6"  Style="{StaticResource MaterialDesignTitleBarButtonStyle}"  Width="46" Height="32">
                    <Path Width="46" Height="32" Data="M 18,11 27,20 M 18,20 27,11"
                    Stroke="{Binding Path=Foreground,RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1" />
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <i:CallMethodAction MethodName="Close"
                    TargetObject="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </Grid>
            <ToolBar Grid.Row="1">
                    <Button ToolTip="Zapisz" Command="{Binding SeveCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="5">
                        <materialDesign:PackIcon Kind="ContentSaveCheckOutline" />
                    </Button>
                    <Button ToolTip="Zapisz jako" Command="{Binding SaveAsCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="5">
                        <materialDesign:PackIcon Kind="ContentSaveAllOutline" />
                    </Button>                    
                    <Button ToolTip="obróć w Lewo" Command="{Binding RotateLeftCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="5">
                        <materialDesign:PackIcon Kind="FileRotateLeftOutline" />
                    </Button>
                    <Button ToolTip="obróć w Prawo" Command="{Binding RotateRightCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="5">
                        <materialDesign:PackIcon Kind="FileRotateRightOutline" />
                    </Button>
                    <Button ToolTip="Przytnij" Command="{Binding CropCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="5">
                        <materialDesign:PackIcon Kind="PlusCircleOutline" />
                    </Button>
                    <Button ToolTip="Zmień rozmiar" Command="{Binding ResizeCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="5">
                        <materialDesign:PackIcon Kind="PlusCircleOutline" />
                    </Button>
                    <Button ToolTip="obij w pionie" Command="{Binding FlipHorizontalCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="5">
                        <materialDesign:PackIcon Kind="FlipHorizontal" />
                    </Button>
                    <Button ToolTip="obij w pionie" Command="{Binding FlipVerticalCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="5">
                        <materialDesign:PackIcon Kind="FlipVertical" />
                    </Button>

            </ToolBar>
            <Grid Grid.Row="2" x:Name="MainGrid">
                    <!--<Image Source="{Binding ImageSource}" Stretch="Uniform" />-->
                    <!--<Canvas x:Name="CanwasToEdit">--> 
                    <!--</Canvas>-->
                <Image HorizontalAlignment="Center" VerticalAlignment="Center"
                        x:Name="ImageToEdit" Source="{Binding Image, Mode=OneWay}"
                           Loaded="Image_Loaded"/>
            </Grid>
            <StatusBar Grid.Row="3" Background="{DynamicResource MaterialDesignToolBarBackground}">
                    <TextBlock Text="    " />
                </StatusBar>            
        </Grid>
    </Border>
</Window>
