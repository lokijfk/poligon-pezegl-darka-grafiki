<UserControl x:Class="poligon_pezeglądarka_grafiki.View.Control.Welcome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:poligon_pezeglądarka_grafiki.View.Control"
             xmlns:vm="clr-namespace:poligon_pezeglądarka_grafiki.ViewModel"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Orientation="Vertical">
            <TextBlock Text=" Witam" />
            <StackPanel Orientation="Horizontal">
                <Label Content="Wersja:"/>
                <Label Content="{Binding version}"/>
                <!-- tu musze dodać możliwość czytania z pliku txt lub rft-->
                
            </StackPanel>

        </StackPanel>
        <Image Source="/img/g1.png" />
    </Grid>
</UserControl>
