<UserControl x:Class="poligon_pezeglądarka_grafiki.View.Control.Welcome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:poligon_pezeglądarka_grafiki.View.Control"
             xmlns:vm="clr-namespace:poligon_pezeglądarka_grafiki.ViewModel"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
            <RichTextBox Width="400" IsReadOnly="True" BorderThickness="0" Background="Transparent" >
                <FlowDocument>
                    <Paragraph TextAlignment="Left">
                        <Run Text="Klawiszologia. " FontStyle="Italic" FontWeight="Bold" />
                        <LineBreak/>
                        <Run Text="Obsługuje formaty takie jak: PNG, JPEG, BMP, GIF, TIFF, WEBP "/>
                        <LineBreak />
                        <Run Text=" odsługiwane formaty zależne są od systemu"/>
                        <LineBreak/>
                        <Run Text="Drak and Drop:"/>
                        <LineBreak/>
                        <Run Text=" - CTRL + LKM - kopiowanie"/>
                        <LineBreak/>
                        <Run Text="- SHIFT + LKM - przenoszenie"/>
                        <LineBreak/>
                        <Run Text="Schowek systemowy: "/>    
                        <LineBreak/>
                        <Run Text="- CTRL + V - wklejanie obrazu z schowka"/>
                        <LineBreak/>
                        <Run Text="- CTRL + C - kopiowanie obrazu do schowka"/>
                        <LineBreak/>
                        <Run Text="- CTRL + X - wycinanie obrazu do schowka, obsługiwanie tylko wewnątrz aplikacji"/>
                        <LineBreak/>
                        <Run Text="Inne: "/>
                        <LineBreak/>
                        <Run Text=" - CTRL + A - zaznacza/odznacza wszystkie elementy w wybranym katalogu" />
                        
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
        </StackPanel>

        <!--TextBlock Text="- Obsługuje formaty takie jak: PNG, JPEG, BMP, GIF, TIFF, WEBP. 
                           Drak and Drop:
                           - CTRL + LKM kopiowanie
                           - SHIFT + LKM przenoszenie
                           Schowek systemowy: 
                            - CTRL + V wklejanie obrazu z schowka
                           - CTRL + C kopiowanie obrazu do schowka
                           - CTRL + X wycinanie obrazu do schowka, obsługiwanie tylko wewnątrz aplikacji
                           
                           
                           "
                           TextWrapping="Wrap" Width="400"/-->

            

        <!--/StackPanel-->
        <!--Image Source="/img/g1.png" /-->
    </Grid>
</UserControl>
