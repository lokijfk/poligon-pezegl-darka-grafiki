<UserControl x:Class="poligon_pezeglądarka_grafiki.View.Control.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:poligon_pezeglądarka_grafiki.View.Control"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             MaxHeight="40" Height="auto"
             >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- ikona i tytół -->
        <Image Grid.Column="0" Width="22" Height="22" Margin="4" Source="/img/73042biohazard_109537(1).ico"/>
        <TextBlock Grid.Column="1" Margin="4 0 0 0" VerticalAlignment="Center" FontSize="14" Text="{Binding WindowTitle}">
            <!--TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                             <Setter Property="Foreground" Value="Gray" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style-->
        </TextBlock>
        <!-- end I and T-->
        <!-- przycisk zmiany ustawień -->
        <Button Grid.Column="2" Style="{StaticResource MaterialDesignTitleBarButtonStyle}"
                               Width="46" Height="32"
                               >
            <materialDesign:PackIcon Kind="CogOutline" />
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click" >
                    <i:InvokeCommandAction 
                                         Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, 
                                         AncestorType={x:Type Window}}, Path=DataContext.SelectionChangedCommand}"
                                         CommandParameter="SettingdFolder"
                                                            />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Button>
        <!-- przycisk zmiany motywu ciemny / jasmy-->
        <Viewbox Grid.Column="3" Height="20">
            <ToggleButton  Style="{StaticResource MaterialDesignSwitchToggleButton}" 
               WindowChrome.IsHitTestVisibleInChrome ="True" 
               IsChecked="{Binding SwitchTglButton}" 
               Command="{Binding SwitchThemeModeCommand}"
               >
                <materialDesign:PackIcon Kind="WhiteBalanceSunny" />
                <materialDesign:ToggleButtonAssist.OnContent>
                    <materialDesign:PackIcon Kind="MoonWaxingCrescent" />
                </materialDesign:ToggleButtonAssist.OnContent>
            </ToggleButton>
        </Viewbox>
        <!-- Przycisk minimalizacji-->
        <Button Grid.Column="4"  RenderOptions.EdgeMode="Aliased"
            Style="{StaticResource MaterialDesignTitleBarButtonStyle}"  Width="46" Height="32"
            Command="{Binding onCmdMinCommand, Mode=OneWay}">

                    <Path
            Width="46" Height="32"
            Data="M 18,15 H 28"
            Stroke="{Binding Path=Foreground,RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
            StrokeThickness="1" />
        </Button>
        <!-- przycisk do maksymalizacji i przywrócenia -->
        <Button Name="maximizeButton" Grid.Column="5"  Style="{StaticResource MaterialDesignTitleBarButtonStyle}" 
                Visibility="{Binding MaximizeButton, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding onCmdMaxCommand, Mode=OneWay}" >
            <Path Width="46" Height="32" Data="M 18.5,10.5 H 27.5 V 19.5 H 18.5 Z" Stroke="{Binding Path=Foreground,
				     RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1" />
        </Button>
        <Button Name="restoreButton" Grid.Column="5"  Style="{StaticResource MaterialDesignTitleBarButtonStyle}"
            Visibility="{Binding RestoreButton, Converter={StaticResource BooleanToVisibilityConverter}}"
            Command="{Binding onCmdMaxCommand, Mode=OneWay}">
            <Path
                    Width="46" Height="32"
                    Data="M 18.5,12.5 H 25.5 V 19.5 H 18.5 Z M 20.5,12.5 V 10.5 H 27.5 V 17.5 H 25.5"
                    Stroke="{Binding Path=Foreground,RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1" />
        </Button>
        <!-- end -->

        <!-- przycisk zamknięcia -->
        <Button Grid.Column="6"  Style="{StaticResource MaterialDesignTitleBarButtonStyle}"  Width="46" Height="32">
            <Path
                Width="46"
                Height="32"
                Data="M 18,11 27,20 M 18,20 27,11"
                Stroke="{Binding Path=Foreground,RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                StrokeThickness="1" />
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                    <i:CallMethodAction MethodName="Close"
                        TargetObject="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Button>
    </Grid>
</UserControl>
