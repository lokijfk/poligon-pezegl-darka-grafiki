<UserControl x:Class="poligon_pezeglądarka_grafiki.View.Control.FileList2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:poligon_pezeglądarka_grafiki.View.Control"
             xmlns:vm="clr-namespace:poligon_pezeglądarka_grafiki.ViewModel"
             xmlns:model="clr-namespace:poligon_pezeglądarka_grafiki.Model"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type model:Photo}">
            <Border Padding="4" Background="White" BorderBrush="#22000000" BorderThickness="1">
                <!--Image Source="{Binding Image.Thumbnail}" /-->
                <StackPanel Orientation="Vertical">
                    <Image Height=" 200" Source="{Binding Image, Mode=OneWay}">
                        <!--Image.Source>
                            <BitmapImage UriSource="{Binding Path}" DecodePixelWidth="200" />
                        </Image.Source-->
                    </Image>
                    <Label              
                        Content="{Binding Name}" Foreground="Black" Width="200">
                        <Label.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </Label.Resources>
                    </Label>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style TargetType="{x:Type ListBox}" x:Key="PhotoListBoxStyle">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border Padding="4" Background="Transparent" BorderBrush="#22000000" BorderThickness="1">
                            <WrapPanel Margin="5" IsItemsHost="True" Orientation="Horizontal"
                                   
                                   VerticalAlignment="Top" HorizontalAlignment="Stretch" />
                            <!--WrapPanel Margin="5" IsItemsHost="True" Orientation="Horizontal"
                            ItemHeight="200"
                            VerticalAlignment="Top" HorizontalAlignment="Stretch" /-->
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border SnapsToDevicePixels="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="red" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </UserControl.Resources>

    <Grid DataContext="{Binding Photos}">
        
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ListBox 
                    IsSynchronizedWithCurrentItem="True"
                    Name="PhotosListBox"
                    Style="{StaticResource PhotoListBoxStyle}"
                    Margin="5"
                    SelectionMode="Extended"
                    ItemsSource="{Binding }" 
                     SelectedIndex="0"
                    MouseDoubleClick="PhotosListBox_MouseDoubleClick"
                     >
                    <!--b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseDoubleClick">
                            <b:InvokeCommandAction Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, 
                                                            AncestorType={x:Type Window}}, Path=DataContext.MouseDoubleClickCommand}"  
                                               
                                                   CommandParameter="{Binding ElementName=PhotosListBox, Path=SelectedIndex}"/>

                        </b:EventTrigger>
                    </b:Interaction.Triggers-->
                </ListBox>
            </ScrollViewer>
        
    </Grid>
</UserControl>
