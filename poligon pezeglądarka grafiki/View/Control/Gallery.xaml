<UserControl x:Class="poligon_pezeglądarka_grafiki.View.Control.Gallery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:poligon_pezeglądarka_grafiki.View.Control"
             xmlns:vm="clr-namespace:poligon_pezeglądarka_grafiki.ViewModel"
             xmlns:converters="clr-namespace:poligon_pezeglądarka_grafiki.View.Converters"
             xmlns:ext="clr-namespace:poligon_pezeglądarka_grafiki.View.ext"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:WidthComverter x:Key="WidthConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ListBox x:Name="Lista" VirtualizingStackPanel.VirtualizationMode="Recycling" 
                 ItemsSource="{Binding Photos}" 
                 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="ListBox_MouseDoubleClick" 
                 MouseMove="ListBox_MouseMove"
                 PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                 PreviewMouseLeftButtonUp="ListBox_PreviewMouseLeftButtonUp"
                 MouseLeftButtonDown="ListBox_MouseLeftButtonDown"
                 KeyDown="ListBox_KeyDown"
                 
                 >
            <ListBox.Resources>
                <ContextMenu x:Key="listViewContextMenu" materialDesign:MenuAssist.MenuItemsPresenterMargin="0">
                    <!--materialDesign:MenuAssist.MenuItemsPresenterMargin="0"-->
                    <MenuItem Header="Zmień nazwę" Click="MenuItem_Rename"/>
                    <MenuItem Header="Wytnij" Click="MenuItem_Click" />
                    <MenuItem Header="Usuń" Click="MenuItem_Delete" />
                    <MenuItem Header="Kopiuj" Click="MenuItem_Click" />
                </ContextMenu>
            </ListBox.Resources>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <Image Source="{Binding Image,Mode=OneWay}" Height="200"/>
                        <Grid Width="{Binding Image.Width,Converter={StaticResource WidthConverter}}">
                            <TextBlock               
                            Text="{Binding Name}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                Width="{Binding Image.Width,Converter={StaticResource WidthConverter}}"
                                TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />               
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding Name,Mode=OneWay}" 
                                     Width="{Binding Image.Width,Converter={StaticResource WidthConverter}}" 
                                     Visibility="Hidden">                                      
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <EventSetter Event="KeyDown" Handler="TextBox_KeyDown" />
                                        <EventSetter Event="LostFocus" Handler="TextBox_LostFocus" />
                                    </Style>                                    
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" >
                    <Setter Property="ContextMenu" Value="{StaticResource listViewContextMenu}"/>
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown" />
                    <EventSetter Event="MouseLeftButtonDown" Handler="ListBoxItem_MouseLeftButtonDown" />
                    <!--EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown" /-->
                    
                    <!--EventSetter Event="MouseDown" Handler="ListBoxItem_MouseDown" /-->
                    <!--EventSetter Event="MouseMove" Handler="ListBoxItem_MouseMove" /-->
                    <!--EventSetter Event="PreviewMouseRightButtonUp" Handler="ListBoxItem_PreviewMouseRightButtonUp" /-->
                    <!--EventSetter Event="PreviewMouseDown" Handler="ListBoxItem_PreviewMouseDown" /-->
                    <!--EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick" /-->
                </Style>
            </ListBox.ItemContainerStyle>

        </ListBox>
    </Grid>
</UserControl>
